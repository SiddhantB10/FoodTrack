# FoodTrack Environment Variables

# ======================
# Frontend (Next.js)
# ======================

# API URL - Change this to your deployed backend URL in production
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Optional: Maps API (for future enhancement)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-api-key

# ======================
# Backend (FastAPI)
# ======================

# Optional: Database URL (for future enhancement)
# DATABASE_URL=postgresql://user:password@localhost:5432/foodtrack

# Optional: Redis Cache (for future enhancement)
# REDIS_URL=redis://localhost:6379

# Optional: External APIs (for future enhancement)
# OPENWEATHER_API_KEY=your-api-key
# TOMTOM_API_KEY=your-api-key
# GOOGLE_MAPS_API_KEY=your-api-key

# ======================
# Security (for production)
# ======================

# Secret key for JWT tokens (generate using: openssl rand -hex 32)
# SECRET_KEY=your-secret-key-here

# CORS Origins (update for production)
# CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
